---
config:
  layout: elk
---
flowchart TB
    Start(["Start Program"]) --> Init["GameScreen Constructor"]
    Init --> CreateLayouts["Create All UI Layouts:<br>- Main Menu<br>- Investigate Location<br>- Interrogate Suspect<br>- View Evidence<br>- Make Accusation"]
    CreateLayouts --> SetMusic["Set Background Music"]
    SetMusic --> ShowMain["Show Main Menu Layout"]
    ShowMain --> GameLoop["Game Loop"] & MainMenu{"Main Menu<br>Choice"}
    GameLoop --> PollEvents{"Poll Events"}
    PollEvents --> CheckClose{"Window<br>Closed?"}
    CheckClose -- Yes --> End(["End Program"])
    CheckClose -- No --> CheckMouse{"Mouse<br>Event?"}
    CheckMouse -- Click --> SetClick["Set isClicking = true"]
    CheckMouse -- Release --> SetRelease["Set isClicking = false"]
    CheckMouse -- None --> UpdateUI["Update Current UI Layout"]
    SetClick --> UpdateUI
    SetRelease --> UpdateUI
    UpdateUI --> DrawUI["Draw UI Layout"]
    DrawUI --> GameLoop
    MainMenu -- Investigate --> InvestigateMenu["Investigate Location Menu"]
    MainMenu -- Interrogate --> InterrogateMenu["Interrogate Suspect Menu"]
    MainMenu -- View Evidence --> CheckEvidence{"Evidence<br>Collected?"}
    MainMenu -- Make Accusation --> CheckEvidenceAccuse{"Evidence<br>Collected?"}
    MainMenu -- Exit --> End
    CheckEvidence -- No --> ShowNoEvidence@{ label: "Show 'No Evidence' Message" }
    ShowNoEvidence --> MainMenu
    CheckEvidence -- Yes --> ViewEvidence["View Evidence Layout"]
    ViewEvidence --> BackToMain1["Back to Main Menu"]
    BackToMain1 --> MainMenu
    CheckEvidenceAccuse -- No --> ShowNoEvidence
    CheckEvidenceAccuse -- Yes --> AccusationMenu["Make Accusation Menu"]
    InvestigateMenu --> InvestChoice{"Choose<br>Location"}
    InvestChoice -- Kitchen --> AddKitchenEvidence["Add Kitchen Evidence<br>Increment Inspections"]
    InvestChoice -- Basement --> AddBasementEvidence["Add Basement Evidence<br>Increment Inspections"]
    InvestChoice -- TV Lounge --> AddTVEvidence["Add TV Lounge Evidence<br>Increment Inspections"]
    InvestChoice -- Garden --> AddGardenEvidence["Add Garden Evidence<br>Increment Inspections"]
    InvestChoice -- Back --> MainMenu
    AddKitchenEvidence --> ShowClue1["Display Clue Text"]
    AddBasementEvidence --> ShowClue1
    AddTVEvidence --> ShowClue1
    AddGardenEvidence --> ShowClue1
    ShowClue1 --> InvestChoice
    InterrogateMenu --> InterroChoice{"Choose<br>Suspect"}
    InterroChoice -- Jackson --> AddJacksonResponse["Add Jackson Evidence<br>Show Response<br>Increment Inspections"]
    InterroChoice -- Hagrid --> AddHagridResponse["Add Hagrid Evidence<br>Show Response<br>Increment Inspections"]
    InterroChoice -- Julian --> AddJulianResponse["Add Julian Evidence<br>Show Response<br>Increment Inspections"]
    InterroChoice -- Back --> MainMenu
    AddJacksonResponse --> ShowResponse["Display Interrogation Response"]
    AddHagridResponse --> ShowResponse
    AddJulianResponse --> ShowResponse
    ShowResponse --> InterroChoice
    AccusationMenu --> AccuseChoice{"Choose<br>Suspect"}
    AccuseChoice -- Jackson --> WrongAccusation1["Wrong Accusation!<br>Real Culprit: Hagrid"]
    AccuseChoice -- Hagrid --> CorrectAccusation["Correct! Hagrid Confessed<br>Case Solved!"]
    AccuseChoice -- Julian --> WrongAccusation2["Wrong Accusation!<br>Real Culprit: Hagrid"]
    AccuseChoice -- Back --> MainMenu
    WrongAccusation1 --> GameEnd["Set gameRunning = false<br>Disable All Buttons<br>Enable Back Buttons"]
    WrongAccusation2 --> GameEnd
    CorrectAccusation --> GameEnd
    GameEnd --> AccuseChoice
    ShowNoEvidence@{ shape: rect}
    style Start fill:#90EE90
    style GameLoop fill:#87CEEB
    style End fill:#FFB6C6
    style MainMenu fill:#DDA0DD
    style WrongAccusation1 fill:#FF6B6B
    style CorrectAccusation fill:#FFD700
    style WrongAccusation2 fill:#FF6B6B
